<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>BandLogServlet</servlet-name>
        <servlet-class>web.BandLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BandLogServlet</servlet-name>
        <url-pattern>/bandlogservlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FanLogServlet</servlet-name>
        <servlet-class>web.FanLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FanLogServlet</servlet-name>
        <url-pattern>/fanlogservlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateFanInfoServlet</servlet-name>
        <servlet-class>web.UpdateFanInfoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateFanInfoServlet</servlet-name>
        <url-pattern>/updatefaninfo</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddDeleteServlet</servlet-name>
        <servlet-class>web.AddDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddDeleteServlet</servlet-name>
        <url-pattern>/adddeleteservlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>BandServlet</servlet-name>
        <servlet-class>web.BandServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BandServlet</servlet-name>
        <url-pattern>/bandservlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>web.SearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/searchservlet</url-pattern>
    </servlet-mapping>
</web-app>